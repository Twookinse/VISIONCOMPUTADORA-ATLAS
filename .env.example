# Copia este archivo como ".env" (en la misma carpeta) y completa los valores.
# El archivo .env esta ignorado por Git: nunca se sube a GitHub.

# Acceso desde OTROS equipos de la red (celular, otra PC). Desde la propia PC
# del servidor (http://localhost:8000) siempre se entra sin contrasena.
# Si NEX_PASSWORD queda vacio, el acceso remoto esta BLOQUEADO.
NEX_USER=nex
NEX_PASSWORD=

# Tamano maximo de un video subido desde el Dashboard (en MB)
NEX_MAX_UPLOAD_MB=4096

# Origenes permitidos para el Dashboard en modo desarrollo (npm run dev)
NEX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
